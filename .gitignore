Root `.gitignore`:
```
# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Environment files
.env
.env.local
.env.development
.env.production
backend/.env*
!backend/.env.example

# Build outputs
dist/
frontend/dist/
frontend/www/
backend/dist/
.angular/

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Docker
docker-compose.override.yml

# Testing
coverage/
.nyc_output/

# Capacitor
frontend/android/
frontend/ios/
frontend/.capacitor/